# ============================================================
# PolyListing AI 环境变量模板（V1.1）
# 复制为 .env 后按需修改。切勿把 .env 提交到版本库。
# 所有 PL_ 前缀变量会被 app/config.py 自动读取。
# ============================================================

# ---------- 服务配置 ----------
PL_HOST=0.0.0.0
PL_PORT=8000
# 运行环境：development（本机开发，可无令牌）/ production（生产，必须配置 PL_API_TOKEN）
# ⚠️ production 未配置 PL_API_TOKEN 时应用将拒绝启动（fail-fast），
#    绝不存在“令牌为空即公开全部管理接口”的生产状态。
PL_ENV=development
# SQLite 开发环境（默认）；生产建议 PostgreSQL：
# PL_DATABASE_URL=postgresql+psycopg://user:password@host:5432/polylisting
PL_DATABASE_URL=
# 可选：数据目录（图片/导出文件存放位置），留空使用 backend/data
PL_DATA_DIR=
# 前端地址（CORS 白名单，多个用英文逗号分隔）
PL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 访问鉴权（V1.1 新增）----------
# API 访问令牌。设置后所有 /api/* 管理接口（除 /api/health、/api/meta）
# 都要求请求头携带 Authorization: Bearer <token> 或 X-API-Token: <token>。
# 生产环境必须设置为强随机值（如 openssl rand -hex 32）。
PL_API_TOKEN=

# ---------- 文本模型（OpenAI 兼容接口）----------
# 留空则 Listing/SEO 生成进入【模拟模式】，结果标记为模拟演示
PL_TEXT_API_BASE=https://api.openai.com/v1
PL_TEXT_API_KEY=
PL_TEXT_MODEL=gpt-4o-mini
# JSON 输出模式：json_object（默认；供应商不支持时自动降级重试）或 none
PL_TEXT_JSON_MODE=json_object

# ---------- 图像模型（OpenAI 兼容接口）----------
# 留空则图片生成进入【模拟模式】，生成带水印的占位图
PL_IMAGE_API_BASE=https://api.openai.com/v1
PL_IMAGE_API_KEY=
PL_IMAGE_MODEL=gpt-image-1

# ---------- 调用控制 ----------
PL_REQUEST_TIMEOUT_SEC=120
PL_MAX_RETRIES=2
# 单个后台任务执行超时（秒），超时标记失败可重试
PL_TASK_TIMEOUT_SEC=600

# ---------- 预算与规模限制 ----------
PL_DAILY_BUDGET_USD=10
PL_PER_TASK_BUDGET_USD=2
PL_MAX_SKUS_PER_TASK=50
PL_MAX_UPLOAD_MB=10
# 上传图片像素上限（防解压炸弹）
PL_MAX_IMAGE_PIXELS=50000000
# 未知模型价格策略：allow=允许执行但费用标记“未知”（不计入预算统计）/ block=拒绝执行
PL_UNKNOWN_COST_POLICY=allow

# ---------- 下载安全（V1.1 新增，SSRF 防护）----------
# 下载模型返回图片 URL 的大小上限（MB）
PL_MAX_DOWNLOAD_MB=20
# 仅开发调试：允许 http 与非公网地址的图片下载（生产严禁开启）
PL_ALLOW_INSECURE_DOWNLOAD=false
