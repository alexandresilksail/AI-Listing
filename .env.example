# ============================================================
# PolyListing AI 环境变量模板
# 复制为 .env 后按需修改。切勿把 .env 提交到版本库。
# 所有 PL_ 前缀变量会被 app/config.py 自动读取。
# ============================================================

# ---------- 服务配置 ----------
PL_HOST=0.0.0.0
PL_PORT=8000
# SQLite 开发环境（默认）；生产建议 PostgreSQL：
# PL_DATABASE_URL=postgresql+psycopg://user:password@host:5432/polylisting
PL_DATABASE_URL=
# 可选：数据目录（图片/导出文件存放位置），留空使用 backend/data
PL_DATA_DIR=
# 前端地址（CORS 白名单，多个用英文逗号分隔）
PL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 文本模型（OpenAI 兼容接口）----------
# 留空则 Listing/SEO 生成进入【模拟模式】，结果标记为模拟演示
PL_TEXT_API_BASE=https://api.openai.com/v1
PL_TEXT_API_KEY=
PL_TEXT_MODEL=gpt-4o-mini

# ---------- 图像模型（OpenAI 兼容接口）----------
# 留空则图片生成进入【模拟模式】，生成带水印的占位图
PL_IMAGE_API_BASE=https://api.openai.com/v1
PL_IMAGE_API_KEY=
PL_IMAGE_MODEL=gpt-image-1

# ---------- 调用控制 ----------
PL_REQUEST_TIMEOUT_SEC=120
PL_MAX_RETRIES=2

# ---------- 预算与规模限制 ----------
PL_DAILY_BUDGET_USD=10
PL_PER_TASK_BUDGET_USD=2
PL_MAX_SKUS_PER_TASK=50
PL_MAX_UPLOAD_MB=10

# ---------- 可选：前端访问令牌 ----------
# 留空表示本机开发不做鉴权；生产部署务必设置并与网关配合
PL_API_TOKEN=
